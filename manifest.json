{
  "manifest_version": 3,
  "name": "Spider SEO \u2014 Tags & Analytics",
  "version": "0.3.0",
  "minimum_chrome_version": "125",
  "description": "Audit selected pages in Chrome: SEO, analytics, consent and local Lighthouse, with optional Spider SEO app/MCP pairing.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "panel.html",
    "default_title": "Spider SEO",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "devtools_page": "devtools.html",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "about.html",
  "homepage_url": "https://spider-seo.app",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
